      "item": [
        {
          "name": "Request OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  const uuid = body?.data?.challenge_uuid;",
                  "  if (uuid) { pm.collectionVariables.set('challenge_uuid', uuid); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{test_phone}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/otp/send",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "otp",
                "send"
              ]
            }
          }
        },
        {
          "name": "Verify OTP (Master Code)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  const token = body?.data?.access_token || body?.data?.token;",
                  "  if (token) { pm.collectionVariables.set('access_token', token); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{test_phone}}\",\n  \"challenge_uuid\": \"{{challenge_uuid}}\",\n  \"otp\": \"{{master_code}}\",\n  \"device_id\": \"test-device-001\",\n  \"fcm_token\": \"test-fcm-token\",\n  \"platform\": \"android\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/otp/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "otp",
                "verify"
              ]
            }
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challenge_uuid\": \"{{challenge_uuid}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/otp/resend",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "otp",
                "resend"
              ]
            }
          }
        },
