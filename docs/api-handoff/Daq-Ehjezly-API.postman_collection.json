{
  "info": {
    "name": "Daq Ehjezly API — دق احجزلي",
    "description": "Syrian Sports Venue Booking Platform API\n\nBase URL: {{base_url}}\nAuth: Bearer Token (set automatically after login)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) { pm.environment.set('token', pm.response.json().data.token); }"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"محمد الأحمد\",\n  \"phone_number\": \"+963944123456\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}" },
            "url": { "raw": "{{base_url}}/v1/auth/register", "host": ["{{base_url}}"], "path": ["v1", "auth", "register"] }
          }
        },
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+963944123456\"\n}" },
            "url": { "raw": "{{base_url}}/v1/auth/otp/send", "host": ["{{base_url}}"], "path": ["v1", "auth", "otp", "send"] }
          }
        },
        {
          "name": "Verify OTP",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) { pm.environment.set('token', pm.response.json().data.token); }"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+963944123456\",\n  \"challenge_uuid\": \"{{challenge_uuid}}\",\n  \"otp\": \"123456\"\n}" },
            "url": { "raw": "{{base_url}}/v1/auth/otp/verify", "host": ["{{base_url}}"], "path": ["v1", "auth", "otp", "verify"] }
          }
        },
        {
          "name": "Google Sign-In",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) { pm.environment.set('token', pm.response.json().data.token); }"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"id_token\": \"firebase-google-id-token\",\n  \"fcm_token\": \"firebase-device-token\"\n}" },
            "url": { "raw": "{{base_url}}/v1/auth/google", "host": ["{{base_url}}"], "path": ["v1", "auth", "google"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/auth/logout", "host": ["{{base_url}}"], "path": ["v1", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Venues",
      "item": [
        {
          "name": "List Venues",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/venues?per_page=15&page=1", "host": ["{{base_url}}"], "path": ["v1", "venues"], "query": [{ "key": "per_page", "value": "15" }, { "key": "page", "value": "1" }, { "key": "city_id", "value": "1", "disabled": true }, { "key": "category_id", "value": "2", "disabled": true }] }
          }
        },
        {
          "name": "Search Venues",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/venues/search?query=ملعب", "host": ["{{base_url}}"], "path": ["v1", "venues", "search"], "query": [{ "key": "query", "value": "ملعب" }] }
          }
        },
        {
          "name": "Get Venue",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/venues/1", "host": ["{{base_url}}"], "path": ["v1", "venues", "1"] }
          }
        },
        {
          "name": "Available Slots",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/venues/1/slots?date=2026-04-25&duration_minutes=60", "host": ["{{base_url}}"], "path": ["v1", "venues", "1", "slots"], "query": [{ "key": "date", "value": "2026-04-25" }, { "key": "duration_minutes", "value": "60" }] }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "List My Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/bookings", "host": ["{{base_url}}"], "path": ["v1", "bookings"], "query": [{ "key": "status", "value": "confirmed", "disabled": true }, { "key": "from_date", "value": "2026-04-01", "disabled": true }, { "key": "to_date", "value": "2026-04-30", "disabled": true }] }
          }
        },
        {
          "name": "Create Booking",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) { pm.environment.set('booking_id', pm.response.json().data.id); }"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"venue_id\": 1,\n  \"booking_date\": \"2026-04-25\",\n  \"start_time\": \"18:00\",\n  \"duration_minutes\": 60,\n  \"payment_mode\": \"deposit\",\n  \"payment_provider\": \"mtn_cash\"\n}" },
            "url": { "raw": "{{base_url}}/v1/bookings", "host": ["{{base_url}}"], "path": ["v1", "bookings"] }
          }
        },
        {
          "name": "Get Booking",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/v1/bookings/{{booking_id}}", "host": ["{{base_url}}"], "path": ["v1", "bookings", "{{booking_id}}"] }
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"confirmed\": true\n}" },
            "url": { "raw": "{{base_url}}/v1/bookings/{{booking_id}}/cancel", "host": ["{{base_url}}"], "path": ["v1", "bookings", "{{booking_id}}", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Initiate Payment (MTN OTP)",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) { pm.environment.set('payment_id', pm.response.json().data.id); }"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"booking_id\": {{booking_id}},\n  \"payment_provider\": \"mtn_cash\",\n  \"phone_number\": \"+963933123456\"\n}" },
            "url": { "raw": "{{base_url}}/v1/payments/initiate", "host": ["{{base_url}}"], "path": ["v1", "payments", "initiate"] }
          }
        },
        {
          "name": "Initiate Payment (Fatora Webview)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"booking_id\": {{booking_id}},\n  \"payment_provider\": \"fatora\"\n}" },
            "url": { "raw": "{{base_url}}/v1/payments/initiate", "host": ["{{base_url}}"], "path": ["v1", "payments", "initiate"] }
          }
        },
        {
          "name": "Confirm MTN OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"payment_id\": {{payment_id}},\n  \"otp\": \"123456\"\n}" },
            "url": { "raw": "{{base_url}}/v1/payments/mtn/confirm", "host": ["{{base_url}}"], "path": ["v1", "payments", "mtn", "confirm"] }
          }
        },
        {
          "name": "Confirm Syriatel OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"payment_id\": {{payment_id}},\n  \"otp\": \"654321\"\n}" },
            "url": { "raw": "{{base_url}}/v1/payments/syriatel/confirm", "host": ["{{base_url}}"], "path": ["v1", "payments", "syriatel", "confirm"] }
          }
        }
      ]
    },
