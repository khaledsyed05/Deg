APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===== Phase 11: Wallet Top-up =====

# Syriatel Cash (also used by booking flow)
PAYMENT_SYRIATEL_BASE_URL=
PAYMENT_SYRIATEL_API_KEY=
PAYMENT_SYRIATEL_MERCHANT_CODE=
PAYMENT_SYRIATEL_WEBHOOK_SECRET=

# MTN Cash (also used by booking flow)
PAYMENT_MTN_BASE_URL=
PAYMENT_MTN_API_KEY=
PAYMENT_MTN_MERCHANT_ID=
PAYMENT_MTN_WEBHOOK_SECRET=

# AlBaraka Bank (hosted-page) — wallet top-up
ALBARAKA_PSP_ID=
ALBARAKA_MPI_ID=
ALBARAKA_MERCHANT_KIT_ID=
ALBARAKA_AUTH_TOKEN=
ALBARAKA_CARD_ACCEPTOR=
ALBARAKA_MCC=7011
ALBARAKA_HOSTED_URL=https://tecom.albaraka.com.sy:8433/ss-ecom-merchant-kit/buyForm/completeTransaction
ALBARAKA_CALLBACK_URL=
ALBARAKA_REDIRECT_URL=

# Wallet limits (override defaults)
WALLET_MIN_TOPUP=5000
WALLET_MAX_TOPUP_PER_TX=1000000
WALLET_DAILY_TOPUP_CAP=10000000
WALLET_BONUS_EXPIRE_DAYS=60

# ===== Football APIs (Phase 12) =====

# football-data.org (Schedules, Standings, Teams)
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# API-Sports (Livescore - 3 free accounts for rotation)
API_SPORTS_KEY_1=
API_SPORTS_KEY_2=
API_SPORTS_KEY_3=
API_SPORTS_BASE_URL=https://v3.football.api-sports.io

# Football Cache TTLs (seconds)
FOOTBALL_CACHE_TODAY=300
FOOTBALL_CACHE_UPCOMING=1800
FOOTBALL_CACHE_STANDINGS=3600
FOOTBALL_CACHE_TEAMS=86400
FOOTBALL_CACHE_LIVE=30

# Football Polling Schedule
FOOTBALL_PEAK_START=15:00
FOOTBALL_PEAK_END=23:00
FOOTBALL_PEAK_INTERVAL=1
FOOTBALL_OFFPEAK_INTERVAL=5

# ===== Firebase / FCM Push Notifications =====

# Firebase project ID (from Google Cloud / Firebase console).
FIREBASE_PROJECT_ID=

# Path to a service-account JSON file. Defaults to storage/app/firebase/service-account.json.
# This file path takes precedence over FIREBASE_SERVICE_ACCOUNT when present on disk.
FIREBASE_CREDENTIALS=

# Inline service-account JSON (single-line, escaped). Used only if FIREBASE_CREDENTIALS file is absent.
FIREBASE_SERVICE_ACCOUNT=
